# ─── Application ──────────────────────────────────────
# Set to 'true' for development (shows test credentials on login, verbose errors)
# MUST be 'false' in production
APP_DEBUG=false
APP_BASE_PATH=/ads_client
APP_SECURE_COOKIES=false

# ─── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academic_management_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ─── OCR Engine Configuration ─────────────────────────
# Engine mode: 'auto' (tries service, falls back to local), 'service' (microservice only), 'local' (local CLI only)
OCR_ENGINE=auto

# Microservice URL (FastAPI with OpenCV preprocessing & pypdfium2)
OCR_SERVER_URL=http://127.0.0.1:8000/ocr
OCR_API_KEY=ads_ocr_secure_secret_key_2026

# Local Tesseract binary path on host (Windows or Linux)
TESSERACT_PATH=D:\tesseract\tesseract.exe

# OCR Quality & Layout Defaults
OCR_DEFAULT_LANG=eng
OCR_DEFAULT_PSM=3
OCR_DEFAULT_OEM=1

# Ingestion Constraints & Security Limits
OCR_MAX_FILE_SIZE_MB=10
OCR_MAX_PAGES=5
OCR_TIMEOUT_SECONDS=30

# Performance Caching (SHA-256 duplicate reuse)
OCR_ENABLE_CACHE=true
OCR_CACHE_TTL=86400

# ─── Application ──────────────────────────────────────
# Set to 'true' for development (shows test credentials on login, verbose errors)
# MUST be 'false' in production
APP_DEBUG=false
APP_BASE_PATH=/ads_client
APP_SECURE_COOKIES=false

# ─── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academic_management_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ─── OCR Microservice (External Linux Server) ───────────
# URL of your separate Linux Tesseract OCR server (e.g. on Render, VPS, or Docker)
OCR_SERVER_URL=http://localhost:8000/ocr
OCR_API_KEY=ads_ocr_secure_secret_key_2026
OCR_MAX_FILE_SIZE_MB=5
OCR_MAX_PAGES=5
OCR_TIMEOUT_SECONDS=30
